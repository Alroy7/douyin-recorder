{
  "check_interval": 60,
  "max_concurrent": 4,
  "use_mock_api": false,
  "cookie": "",
  "proxy": "",
  "max_poll_workers": 12,
  "poll_rate_limit": 6,
  "poll_interval_live": 30,
  "poll_interval_warm": 90,
  "poll_interval_cold": 300,
  "poll_backoff_start": 30,
  "poll_backoff_max": 300,
  "breaker_window_seconds": 30,
  "breaker_error_rate": 0.3,
  "breaker_min_requests": 20,
  "breaker_pause_start": 30,
  "breaker_pause_max": 120,
  "breaker_halfopen_requests": 5,
  "resolve_workers": 3,
  "resolve_retries": 2,
  "max_total_mbps": 0,
  "max_ffmpeg_processes": 300,
  "output_dir": "D:\\Code\\DS-Workspace\\douyin-recorder\\tests\\soak\\out_real\\real",
  "output_template": "{anchor}/{date}",
  "filename_template": "{anchor}_{date}_{time}",
  "ffmpeg_path": "",
  "ffmpeg_extra_args": [],
  "ffmpeg_http_args": [
    "-user_agent",
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
    "-referer",
    "https://live.douyin.com/",
    "-timeout",
    "15000000",
    "-rw_timeout",
    "15000000",
    "-reconnect",
    "1",
    "-reconnect_on_network_error",
    "1",
    "-reconnect_on_http_error",
    "403,404,500,502,503,504",
    "-reconnect_streamed",
    "1",
    "-reconnect_delay_max",
    "10",
    "-reconnect_max_retries",
    "3",
    "-reconnect_delay_total_max",
    "30",
    "-fflags",
    "+genpts",
    "-analyzeduration",
    "5000000",
    "-probesize",
    "5000000"
  ],
  "container": "ts",
  "remux_mp4": false,
  "keep_source": false,
  "segment_duration": 0,
  "segment_size_mb": 0,
  "stall_check_seconds": 30,
  "stall_kill_after": 2,
  "quality": "origin",
  "retry_max": 2,
  "retry_interval": 5,
  "retry_interval_max": 60,
  "min_free_gb": 1.0,
  "keep_days": 0,
  "keep_max_files": 0,
  "min_keep_seconds": 5,
  "record_timeout_min": 1,
  "graceful_stop_timeout": 20,
  "notify": {
    "enabled": false,
    "webhooks": [],
    "sound": false,
    "events": []
  },
  "log_dir": "D:\\Code\\DS-Workspace\\douyin-recorder\\tests\\soak\\logs_real",
  "log_level": "WARNING",
  "log_keep_days": 30,
  "ui_refresh_ms": 1000
}